  "handlers": [
    "armed_timeout_seconds :: oninput=scheduleAutoSave()",
    "autosave-toggle :: onclick=toggleAutoSave()",
    "button :: onclick=_hideVolumeWarning()",
    "button :: onclick=cancelCopyChoice()",
    "button :: onclick=closeCopyLotsModal()",
    "button :: onclick=confirmCopyChoice()",
    "button :: onclick=downloadSession('${s.id}', '${s.name}')",
    "button :: onclick=executeLotCopy()",
    "button :: onclick=goBackToCopyStep1()",
    "button :: onclick=goToCopyStep2()",
    "button :: onclick=loadHistory()",
    "button :: onclick=logout()",
    "button :: onclick=startAllSymbols()",
    "button :: onclick=startSymbol('${symbol}')",
    "button :: onclick=stopAllSymbols()",
    "button :: onclick=stopSymbol('${symbol}')",
    "button :: onclick=terminateAllSymbols()",
    "button :: onclick=terminateSymbol('${symbol}')",
    "button :: onclick=toggleTheme()",
    "button :: onclick=viewSession('${s.id}')",
    "cancel_ack_deadline_ms :: oninput=scheduleAutoSave()",
    "copy-lot-btn :: onclick=openCopyLotsModal()",
    "form :: onsubmit=updateConfig(event)",
    "form-login :: onsubmit=handleSupabaseLogin(event)",
    "max_consecutive_open_failures :: oninput=scheduleAutoSave()",
    "max_runtime_minutes :: oninput=scheduleAutoSave()",
    "sym_${safe}_buy_count :: oninput=setLastInteracted('${symbol}', '${safe}'); scheduleAutoSave()",
    "sym_${safe}_buy_lot :: oninput=setLastInteracted('${symbol}', '${safe}'); scheduleAutoSave()",
    "sym_${safe}_constant_freq :: oninput=scheduleAutoSave()",
    "sym_${safe}_constant_side :: onchange=scheduleAutoSave()",
    "sym_${safe}_enabled :: onchange=onSymbolToggle('${symbol}', this)",
    "sym_${safe}_entry_offset :: oninput=scheduleAutoSave()",
    "sym_${safe}_grid_distance :: oninput=scheduleAutoSave()",
    "sym_${safe}_moving_freq :: oninput=scheduleAutoSave()",
    "sym_${safe}_sell_count :: oninput=setLastInteracted('${symbol}', '${safe}'); scheduleAutoSave()",
    "sym_${safe}_sell_lot :: oninput=setLastInteracted('${symbol}', '${safe}'); scheduleAutoSave()",
    "tab-config :: onclick=switchTab('config')",
    "tab-dashboard :: onclick=switchTab('dashboard')",
    "tab-logs :: onclick=switchTab('logs')",
    "toggle-btn :: onclick=toggleBot()",
    "win_fill_deadline_ms :: oninput=scheduleAutoSave()"
  ],
