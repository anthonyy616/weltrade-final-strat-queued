# --- EA bulk executor (all optional, defaults in code) ---
# EA_AUTO_RESTART=true        # allow MT5 relaunch with the EA attached when safe (no open positions)
# EA_CHART_SYMBOL='FX Vol 20' # chart the EA attaches to on relaunch
# EA_CHART_PERIOD='M1'        # chart period for the EA on relaunch
# MT5_COMMON_FILES=''         # override the Common\Files folder (see note above)
# EA_COMPILE_TIMEOUT=60       # seconds allowed for MetaEditor compilation